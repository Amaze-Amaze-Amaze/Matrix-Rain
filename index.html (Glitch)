<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>3D Glitched Matrix Rain</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html, body {
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: #010402;
      font-family: "Courier New", Courier, monospace;
    }

    canvas {
      display: block;
      width: 100vw;
      height: 100vh;
    }

    /* Subtle CRT scanlines + vignette overlay */
    .crt-overlay {
      position: fixed;
      inset: 0;
      pointer-events: none;
      background:
        radial-gradient(circle at center, transparent 55%, rgba(0, 0, 0, 0.72) 100%),
        repeating-linear-gradient(
          to bottom,
          rgba(0, 255, 110, 0.03) 0px,
          rgba(0, 255, 110, 0.03) 1px,
          transparent 1px,
          transparent 3px
        );
      z-index: 2;
    }

    .hud {
      position: fixed;
      bottom: 14px;
      left: 16px;
      z-index: 3;
      color: rgba(80, 255, 140, 0.55);
      font-size: 12px;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      pointer-events: none;
      user-select: none;
      text-shadow: 0 0 8px rgba(0, 255, 110, 0.45);
    }
  </style>
</head>
<body>
  <canvas id="matrix"></canvas>
  <div class="crt-overlay"></div>
  <div class="hud">SYSTEM :// ERROR</div>

  <script>
    const canvas = document.getElementById("matrix");
    const ctx = canvas.getContext("2d", { alpha: false });

    let width = (canvas.width = window.innerWidth);
    let height = (canvas.height = window.innerHeight);

    // Character set: Half-width Katakana + Latin + Numbers + Glitch Symbols
    const chars =
      "ｱｲｳｴｵｶｷｸｹｺｻｼｽｾｿﾀﾁﾂﾃﾄﾅﾆﾇﾈﾉﾊﾋﾌﾍﾎﾏﾐﾑﾒﾓﾔﾕﾖﾗﾘﾙﾚﾛﾜﾝ0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ#$%&*+=-<>?@";

    // Camera / 3D perspective settings
    const FOV = 520;
    const Z_MIN = 40;
    const Z_MAX = 1400;
    const STREAM_COUNT = 220;

    // Mouse parallax & interactive glitch surge
    let targetYaw = 0;
    let targetPitch = 0;
    let currentYaw = 0;
    let currentPitch = 0;
    let glitchIntensity = 0;
    let surgeTimer = 0;

    window.addEventListener("resize", () => {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    });

    window.addEventListener("mousemove", (e) => {
      const nx = (e.clientX / width) * 2 - 1;
      const ny = (e.clientY / height) * 2 - 1;
      targetYaw = nx * 0.45;
      targetPitch = ny * 0.25;
    });

    window.addEventListener("mousedown", () => {
      surgeTimer = 28;
    });

    function randomChar() {
      return chars[(Math.random() * chars.length) | 0];
    }

    class RainStream {
      constructor(initial = false) {
        this.reset(initial);
      }

      reset(initial = false) {
        // Spread streams across wide 3D volume
        this.x = (Math.random() - 0.5) * 2600;
        this.z = initial
          ? Z_MIN + Math.random() * (Z_MAX - Z_MIN)
          : Z_MIN + Math.random() * (Z_MAX - Z_MIN);

        this.length = 10 + ((Math.random() * 24) | 0);
        this.charSpacing = 24;
        this.speed = 3.2 + Math.random() * 6.5;
        this.zSpeed = (Math.random() - 0.42) * 1.4; // Subtle depth drift

        const topLimit = -1200;
        const bottomLimit = 1200;
        this.y = initial
          ? topLimit + Math.random() * (bottomLimit - topLimit)
          : topLimit - Math.random() * 500;

        this.glyphs = Array.from({ length: this.length }, () => randomChar());
        this.mutateRate = 0.03 + Math.random() * 0.08;
        this.glitchOffset = 0;
        this.isCorrupted = Math.random() < 0.16;
      }

      update(globalGlitch) {
        this.y += this.speed;
        this.z += this.zSpeed;

        // Recycle depth smoothly
        if (this.z < Z_MIN) this.z = Z_MAX;
        if (this.z > Z_MAX) this.z = Z_MIN;

        // Randomly mutate characters in the trail
        for (let i = 0; i < this.length; i++) {
          if (Math.random() < this.mutateRate + globalGlitch * 0.15) {
            this.glyphs[i] = randomChar();
          }
        }

        // Occasional horizontal jitter per stream
        if (Math.random() < 0.03 + globalGlitch * 0.2) {
          this.glitchOffset = (Math.random() - 0.5) * (18 + globalGlitch * 65);
        } else {
          this.glitchOffset *= 0.72;
        }

        const tailY = this.y - this.length * this.charSpacing;
        if (tailY > 1250) {
          this.reset(false);
        }
      }

      project(x, y, z) {
        // Apply subtle 3D Y-axis and X-axis camera rotation
        const cosY = Math.cos(currentYaw);
        const sinY = Math.sin(currentYaw);
        const rx = x * cosY - (z - 650) * sinY;
        const rz1 = x * sinY + (z - 650) * cosY + 650;

        const cosX = Math.cos(currentPitch);
        const sinX = Math.sin(currentPitch);
        const ry = y * cosX - (rz1 - 650) * sinX;
        const rz = y * sinX + (rz1 - 650) * cosX + 650;

        if (rz <= 15) return null;

        const scale = FOV / rz;
        return {
          sx: width * 0.5 + rx * scale,
          sy: height * 0.5 + ry * scale,
          scale,
          depth: rz
        };
      }

      draw(globalGlitch) {
        const depthNorm = 1 - Math.min(1, Math.max(0, (this.z - Z_MIN) / (Z_MAX - Z_MIN)));
        const baseAlpha = 0.15 + depthNorm * 0.85;

        for (let i = 0; i < this.length; i++) {
          const charY = this.y - i * this.charSpacing;
          const charX = this.x + this.glitchOffset * (i % 3 === 0 ? 1.4 : 0.6);
          const p = this.project(charX, charY, this.z);

          if (!p) continue;
          if (p.sx < -60 || p.sx > width + 60 || p.sy < -60 || p.sy > height + 60) continue;

          const fontSize = Math.max(6, Math.min(46, 22 * p.scale));
          ctx.font = `bold ${fontSize | 0}px "Courier New", monospace`;

          const fade = 1 - i / this.length;
          const alpha = baseAlpha * fade;

          if (i === 0) {
            // Bright white-green leading character
            ctx.fillStyle = `rgba(220, 255, 235, ${Math.min(1, alpha * 1.35)})`;
          } else if (this.isCorrupted && (i % 4 === 0 || globalGlitch > 0.4)) {
            // Corrupted cyan / crimson anomaly glyph
            ctx.fillStyle =
              Math.random() > 0.35
                ? `rgba(0, 245, 255, ${alpha * 0.9})`
                : `rgba(255, 45, 95, ${alpha * 0.85})`;
          } else {
            // Classic phosphor Matrix green
            const g = (170 + depthNorm * 85) | 0;
            const r = (depthNorm * 35) | 0;
            const b = (40 + depthNorm * 55) | 0;
            ctx.fillStyle = `rgba(${r}, ${g}, ${b}, ${alpha})`;
          }

          // Chromatic aberration split during glitch spikes
          if (globalGlitch > 0.25 && depthNorm > 0.45 && i < 5) {
            const split = (2 + globalGlitch * 8) * p.scale;
            ctx.fillStyle = `rgba(255, 0, 80, ${alpha * 0.65})`;
            ctx.fillText(this.glyphs[i], p.sx - split, p.sy);
            ctx.fillStyle = `rgba(0, 255, 255, ${alpha * 0.65})`;
            ctx.fillText(this.glyphs[i], p.sx + split, p.sy);
            ctx.fillStyle = `rgba(180, 255, 200, ${alpha})`;
          }

          ctx.fillText(this.glyphs[i], p.sx, p.sy);
        }
      }
    }

    const streams = Array.from({ length: STREAM_COUNT }, () => new RainStream(true));

    // Horizontal screen-tear glitch slices
    function applyGlitchSlices(intensity) {
      if (intensity <= 0.05) return;

      const sliceCount = 2 + ((intensity * 10) | 0);
      for (let i = 0; i < sliceCount; i++) {
        const sy = (Math.random() * height) | 0;
        const sh = 4 + ((Math.random() * (24 + intensity * 45)) | 0);
        const dx = ((Math.random() - 0.5) * (30 + intensity * 140)) | 0;

        ctx.drawImage(canvas, 0, sy, width, sh, dx, sy, width, sh);

        // Occasional neon glitch bar flash
        if (Math.random() < 0.35) {
          ctx.fillStyle =
            Math.random() > 0.5
              ? `rgba(0, 255, 140, ${0.06 * intensity})`
              : `rgba(255, 20, 90, ${0.08 * intensity})`;
          ctx.fillRect(0, sy, width, Math.max(2, sh * 0.35));
        }
      }
    }

    function animate() {
      // Smooth camera interpolation
      currentYaw += (targetYaw - currentYaw) * 0.06;
      currentPitch += (targetPitch - currentPitch) * 0.06;

      // Random ambient glitch bursts + click-triggered surge
      if (surgeTimer > 0) {
        surgeTimer--;
        glitchIntensity = Math.min(1, glitchIntensity + 0.25);
      } else if (Math.random() < 0.025) {
        glitchIntensity = 0.35 + Math.random() * 0.65;
      } else {
        glitchIntensity *= 0.86;
      }

      // Motion-blur trail background clear
      ctx.fillStyle = glitchIntensity > 0.5 ? "rgba(1, 8, 4, 0.32)" : "rgba(1, 5, 2, 0.24)";
      ctx.fillRect(0, 0, width, height);

      // Sort back-to-front so closer streams render crisply over distant ones
      streams.sort((a, b) => b.z - a.z);

      for (let i = 0; i < streams.length; i++) {
        streams[i].update(glitchIntensity);
        streams[i].draw(glitchIntensity);
      }

      applyGlitchSlices(glitchIntensity);

      requestAnimationFrame(animate);
    }

    animate();
  </script>
</body>
</html>
