<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>3D Matrix Digital Rain</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body, html {
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: #000;
            font-family: monospace;
        }
        canvas {
            display: block;
            width: 100vw;
            height: 100vh;
        }
    </style>
</head>
<body>

    <canvas id="matrixCanvas"></canvas>

    <script>
        const canvas = document.getElementById('matrixCanvas');
        const ctx = canvas.getContext('2d');

        // Set canvas to full window size
        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        resizeCanvas();
        window.addEventListener('resize', resizeCanvas);

        // Matrix characters: Katakana, Latin, and Numbers
        const chars = "ｦｧｨｩｪｫｬｭｮｯｰｱｲｳｴｵｶｷｸｹｺｻｼｽｾｿﾀﾁﾂﾃﾄﾅﾆﾇﾈﾉﾊﾋﾌﾍﾎﾏﾐﾑﾒﾓﾔﾕﾖﾗﾘﾙﾚﾛﾜﾝ1234567890ABCDEFGHIJKLMNOPQRSTUVWXYZ";
        const charArray = chars.split('');

        // Configuration
        const maxStreams = 250; // Total number of simultaneous falling code streams
        const streams = [];

        class CodeStream {
            constructor() {
                this.init(true); // Initial setup, spread across the screen height
            }

            init(isFirstLoad = false) {
                // X coordinate spacing
                this.x = Math.random() * canvas.width;
                
                // Y coordinate: start above viewport, or randomly distributed if first loading
                this.y = isFirstLoad ? (Math.random() * canvas.height * -1.5) : (Math.random() * -200 - 50);
                
                // 3D Depth Layer (0.1 = Far away / small / slow, 1.0 = Very close / large / fast)
                this.z = Math.random() * 0.9 + 0.1; 
                
                // Base font size scaled by depth layer
                this.baseFontSize = 20;
                this.fontSize = this.baseFontSize * this.z;
                
                // Speed scaled by depth layer
                this.speed = (Math.random() * 3 + 2) * this.z;
                
                // Length of the stream
                this.length = Math.floor(Math.random() * 20) + 10;
                
                // Opacity modifier based on depth
                this.opacity = this.z;
            }

            draw() {
                // Track dynamic character rendering within a column framework
                let currentY = this.y;

                for (let i = 0; i < this.length; i++) {
                    // Skip rendering if the individual character is above the viewport
                    if (currentY < 0 || currentY > canvas.height) {
                        currentY += this.fontSize;
                        continue;
                    }

                    // Pick a random symbol
                    const randomChar = charArray[Math.floor(Math.random() * charArray.length)];
                    
                    ctx.font = `${this.fontSize}px monospace`;

                    if (i === 0) {
                        // The leading character "head" glows bright white/light green
                        ctx.fillStyle = `rgba(200, 255, 200, ${this.opacity})`;
                        ctx.shadowBlur = 10 * this.z;
                        ctx.shadowColor = '#00ff00';
                    } else {
                        // Trailing characters fade to green and respect 3D depth opacity
                        const fadeRatio = 1 - (i / this.length);
                        ctx.fillStyle = `rgba(0, 255, 70, ${this.opacity * fadeRatio})`;
                        ctx.shadowBlur = 0; // Turn off glow for trail performance
                    }

                    ctx.fillText(randomChar, this.x, currentY);
                    currentY += this.fontSize; // Distance to the next character in stream
                }
            }

            update() {
                this.y += this.speed;

                // Reset stream to the top with new randomized 3D specs once it leaves the viewport
                if (this.y - (this.length * this.fontSize) > canvas.height) {
                    this.init(false);
                }
            }
        }

        // Initialize streams
        for (let i = 0; i < maxStreams; i++) {
            streams.push(new CodeStream());
        }

        // Animation Loop
        function animate() {
            // Draws a highly translucent black background layer to generate trailing trails
            ctx.fillStyle = 'rgba(0, 0, 0, 0.15)';
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            // Sort streams by depth (Z index) so further elements render behind closer ones
            streams.sort((a, b) => a.z - b.z);

            // Draw and update each stream
            streams.forEach(stream => {
                stream.draw();
                stream.update();
            });

            requestAnimationFrame(animate);
        }

        animate();
    </script>
</body>
</html>
