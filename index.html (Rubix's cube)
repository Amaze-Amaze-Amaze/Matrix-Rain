<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>3D Matrix Rubik's Cube</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body, html {
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: #000;
            font-family: 'Courier New', Courier, monospace;
        }

        /* Matrix Rain Background Canvas */
        #matrixCanvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
            opacity: 0.35;
        }

        /* Scene Container */
        .scene {
            position: relative;
            width: 100vw;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            perspective: 1000px;
            z-index: 2;
        }

        /* Rubik's Cube 3D Wrapper */
        .cube-container {
            width: 200px;
            height: 200px;
            position: relative;
            transform-style: preserve-3d;
            animation: rotateScene 15s infinite linear;
        }

        .rubiks-cube {
            width: 100%;
            height: 100%;
            position: relative;
            transform-style: preserve-3d;
            transform: rotateX(-25deg) rotateY(45deg);
        }

        /* Individual Cubelets */
        .cubelet {
            position: absolute;
            width: 60px;
            height: 60px;
            transform-style: preserve-3d;
            border: 1px solid #003300;
            transition: transform 0.6s cubic-bezier(0.68, -0.55, 0.27, 1.55);
        }

        /* Faces of Cubelets covered in Matrix-style digital canvas */
        .face {
            position: absolute;
            width: 60px;
            height: 60px;
            background: rgba(0, 15, 0, 0.85);
            border: 1px solid #0f0;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            box-shadow: inset 0 0 10px rgba(0, 255, 0, 0.5);
        }

        .face canvas {
            width: 100%;
            height: 100%;
        }

        .face.front  { transform: translateZ(30px); }
        .face.back   { transform: rotateY(180deg) translateZ(30px); }
        .face.right  { transform: rotateY(90deg) translateZ(30px); }
        .face.left   { transform: rotateY(-90deg) translateZ(30px); }
        .face.top    { transform: rotateX(90deg) translateZ(30px); }
        .face.bottom { transform: rotateX(-90deg) translateZ(30px); }

        @keyframes rotateScene {
            0% { transform: rotateX(0deg) rotateY(0deg); }
            100% { transform: rotateX(360deg) rotateY(360deg); }
        }

        .title {
            position: absolute;
            bottom: 20px;
            color: #0f0;
            font-size: 14px;
            letter-spacing: 3px;
            text-shadow: 0 0 8px #0f0;
            z-index: 10;
        }
    </style>
</head>
<body>

    <!-- Background Matrix Rain -->
    <canvas id="matrixCanvas"></canvas>

    <div class="scene">
        <div class="cube-container">
            <div class="rubiks-cube" id="rubiksCube">
                <!-- 27 Cubelets will be generated via JS -->
            </div>
        </div>
    </div>

    <div class="title">SYSTEM: MATRIX_CUBE // SCRAMBLING & SOLVING LOOP</div>

    <script>
        // 1. Background Matrix Code Rain
        const bgCanvas = document.getElementById('matrixCanvas');
        const bgCtx = bgCanvas.getContext('2d');

        function resizeBg() {
            bgCanvas.width = window.innerWidth;
            bgCanvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeBg);
        resizeBg();

        const letters = '01ABCDEFXYZ\$+-*=%";#@&?!';
        const fontSize = 16;
        let columns = Math.floor(bgCanvas.width / fontSize);
        let drops = Array(columns).fill(1);

        function drawMatrixRain() {
            bgCtx.fillStyle = 'rgba(0, 0, 0, 0.08)';
            bgCtx.fillRect(0, 0, bgCanvas.width, bgCanvas.height);
            bgCtx.fillStyle = '#0F0';
            bgCtx.font = fontSize + 'px monospace';

            for (let i = 0; i < drops.length; i++) {
                const text = letters.charAt(Math.floor(Math.random() * letters.length));
                bgCtx.fillText(text, i * fontSize, drops[i] * fontSize);
                if (drops[i] * fontSize > bgCanvas.height && Math.random() > 0.975) {
                    drops[i] = 0;
                }
                drops[i]++;
            }
        }
        setInterval(drawMatrixRain, 50);

        // 2. Build Mini Matrix Canvases for Cube Faces
        function createMiniMatrixCanvas() {
            const c = document.createElement('canvas');
            c.width = 60;
            c.height = 60;
            const ctx = c.getContext('2d');
            const chars = '01';
            let frame = 0;

            function renderMini() {
                ctx.fillStyle = 'rgba(0, 20, 0, 0.3)';
                ctx.fillRect(0, 0, 60, 60);
                ctx.fillStyle = '#0f0';
                ctx.font = '10px monospace';
                for (let y = 10; y <= 50; y += 12) {
                    for (let x = 5; x <= 50; x += 12) {
                        const char = chars.charAt(Math.floor(Math.random() * chars.length));
                        ctx.fillText(char, x, y);
                    }
                }
            }
            setInterval(renderMini, 150 + Math.random() * 150);
            renderMini();
            return c;
        }

        // 3. Generate 3x3x3 Rubik's Cube Structure
        const cubeEl = document.getElementById('rubiksCube');
        const cubelets = [];
        const size = 66; // offset per cubelet

        for (let x = -1; x <= 1; x++) {
            for (let y = -1; y <= 1; y++) {
                for (let z = -1; z <= 1; z++) {
                    const cubelet = document.createElement('div');
                    cubelet.classList.add('cubelet');
                    cubelet.style.transform = `translate3d(${x * size}px, ${y * size}px, ${z * size}px)`;
                    
                    ['front', 'back', 'right', 'left', 'top', 'bottom'].forEach(faceName => {
                        const face = document.createElement('div');
                        face.classList.add('face', faceName);
                        face.appendChild(createMiniMatrixCanvas());
                        cubelet.appendChild(face);
                    });

                    cubeEl.appendChild(cubelet);
                    cubelets.push({ el: cubelet, x, y, z });
                }
            }
        }

        // 4. Automated Scramble and Solve Loop Animation
        const axes = ['x', 'y', 'z'];
        const layers = [-1, 0, 1];
        const angles = [90, -90, 180];
        let isScrambling = true;
        let moveHistory = [];

        function rotateLayer(axis, layerVal, angle, duration = 500) {
            return new Promise(resolve => {
                cubelets.forEach(c => {
                    let match = false;
                    if (axis === 'x' && c.x === layerVal) match = true;
                    if (axis === 'y' && c.y === layerVal) match = true;
                    if (axis === 'z' && c.z === layerVal) match = true;

                    if (match) {
                        // Apply temporary rotation transform
                        c.el.style.transition = `transform ${duration}ms ease-in-out`;
                        // Simple visual shift animation pulse
                        const currentTransform = c.el.style.transform;
                        c.el.style.transform += ` rotate${axis.toUpperCase()}(${angle}deg)`;
                    }
                });
                setTimeout(resolve, duration);
            });
        }

        async function runCubeLoop() {
            while (true) {
                moveHistory = [];
                // Scramble phase (10 random moves)
                isScrambling = true;
                for (let i = 0; i < 10; i++) {
                    const axis = axes[Math.floor(Math.random() * axes.length)];
                    const layer = layers[Math.floor(Math.random() * layers.length)];
                    const angle = angles[Math.floor(Math.random() * 2)]; // 90 or -90
                    moveHistory.push({ axis, layer, angle: -angle }); // store reverse for solving
                    await rotateLayer(axis, layer, angle, 400);
                }

                await new Promise(r => setTimeout(r, 1000));

                // Solve phase (reverse moves)
                isScrambling = false;
                while (moveHistory.length > 0) {
                    const move = moveHistory.pop();
                    await rotateLayer(move.axis, move.layer, move.angle, 400);
                }

                // Reset exact positions cleanly
                cubelets.forEach(c => {
                    c.el.style.transition = 'transform 0.5s ease';
                    c.el.style.transform = `translate3d(${c.x * size}px, ${c.y * size}px, ${c.z * size}px)`;
                });

                await new Promise(r => setTimeout(r, 1500));
            }
        }

        setTimeout(runCubeLoop, 1000);
    </script>
</body>
</html>
